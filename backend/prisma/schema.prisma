generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PRESS_OPERATOR
  DRIVER
  SALES
  CUSTOMER
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  CORPORATE
}

enum PaymentType {
  FULL
  DEPOSIT_PCT
  DEPOSIT_FIXED
  COD
}

enum OrderStatus {
  NEW
  IN_PRODUCTION
  READY
  DELIVERED
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum InvoiceStatus {
  UNPAID
  SENT
  PARTIAL
  PAID
  OVERDUE
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ProofStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

enum DeliveryStatus {
  SCHEDULED
  PENDING
  DELIVERED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SALES)
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  capturedOrders   Order[]    @relation("CapturedOrders")
  capturedQuotes   Quote[]    @relation("CapturedQuotes")
  capturedInvoices Invoice[]  @relation("CapturedInvoices")
  recordedPayments Payment[]  @relation("RecordedPayments")
  uploadedProofs   Proof[]    @relation("UploadedProofs")
  proofComments    ProofComment[]
  driverDeliveries Delivery[] @relation("DriverDeliveries")
  waLogs           WaLog[]
  notifLogs        NotificationLog[]
}

model Customer {
  id            String       @id @default(uuid())
  name          String
  contactPerson String?
  email         String
  phone         String
  address       String?
  type          CustomerType @default(INDIVIDUAL)
  createdAt     DateTime     @default(now())
  orders   Order[]
  quotes   Quote[]
  invoices Invoice[]
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  capturedById    String
  jobName         String
  jobType         String
  quantity        Int
  totalValue      Decimal     @db.Decimal(10,2)
  paymentType     PaymentType @default(FULL)
  depositAmount   Decimal     @db.Decimal(10,2) @default(0)
  depositPct      Int         @default(0)
  depositFixed    Decimal     @db.Decimal(10,2) @default(0)
  depositReceived Boolean     @default(false)
  balancePaid     Boolean     @default(false)
  status          OrderStatus @default(NEW)
  priority        Priority    @default(MEDIUM)
  dueDate         DateTime
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  capturedBy User     @relation("CapturedOrders", fields: [capturedById], references: [id])
  payments   Payment[]
  invoices   Invoice[]
  proofs     Proof[]
  deliveries Delivery[]
  waLogs     WaLog[]
}

model Payment {
  id           String   @id @default(uuid())
  orderId      String
  recordedById String
  paymentType  String
  amount       Decimal  @db.Decimal(10,2)
  method       String
  paymentDate  DateTime
  notes        String?
  createdAt    DateTime @default(now())
  order      Order @relation(fields: [orderId], references: [id])
  recordedBy User  @relation("RecordedPayments", fields: [recordedById], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String
  customerId    String
  capturedById  String
  invoiceType   String
  amount        Decimal       @db.Decimal(10,2)
  amountPaid    Decimal       @db.Decimal(10,2) @default(0)
  status        InvoiceStatus @default(UNPAID)
  invoiceDate   DateTime
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  capturedBy User     @relation("CapturedInvoices", fields: [capturedById], references: [id])
  reminderLogs     ReminderLog[]
  notificationLogs NotificationLog[]
}

model Quote {
  id           String      @id @default(uuid())
  quoteNumber  String      @unique
  customerId   String
  capturedById String
  description  String
  jobType      String
  quantity     Int
  value        Decimal     @db.Decimal(10,2)
  validUntil   DateTime
  status       QuoteStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  capturedBy User     @relation("CapturedQuotes", fields: [capturedById], references: [id])
}

model Proof {
  id           String      @id @default(uuid())
  orderId      String
  uploadedById String
  fileName     String
  fileUrl      String
  version      String
  status       ProofStatus @default(PENDING)
  notes        String?
  createdAt    DateTime    @default(now())
  order      Order          @relation(fields: [orderId], references: [id])
  uploadedBy User           @relation("UploadedProofs", fields: [uploadedById], references: [id])
  comments   ProofComment[]
}

model ProofComment {
  id        String   @id @default(uuid())
  proofId   String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  proof Proof @relation(fields: [proofId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

model Delivery {
  id           String         @id @default(uuid())
  orderId      String
  driverId     String
  address      String
  deliveryDate DateTime
  timeSlot     String
  status       DeliveryStatus @default(SCHEDULED)
  createdAt    DateTime       @default(now())
  order  Order @relation(fields: [orderId], references: [id])
  driver User  @relation("DriverDeliveries", fields: [driverId], references: [id])
}

model StockItem {
  id        String   @id @default(uuid())
  name      String
  category  String
  quantity  Int      @default(0)
  minLevel  Int      @default(0)
  unit      String
  updatedAt DateTime @updatedAt
}

model ReminderSchedule {
  id          String  @id @default(uuid())
  daysOffset  Int
  label       String
  triggerType String
  channels    Json
  active      Boolean @default(true)
  logs ReminderLog[]
}

model ReminderLog {
  id         String   @id @default(uuid())
  invoiceId  String
  scheduleId String
  channel    String
  status     String
  sentAt     DateTime @default(now())
  invoice  Invoice          @relation(fields: [invoiceId], references: [id])
  schedule ReminderSchedule @relation(fields: [scheduleId], references: [id])
}

model WaLog {
  id            String   @id @default(uuid())
  orderId       String
  customerPhone String
  templateName  String
  status        String
  sentById      String
  sentAt        DateTime @default(now())
  order  Order @relation(fields: [orderId], references: [id])
  sentBy User  @relation(fields: [sentById], references: [id])
}

model NotificationLog {
  id        String   @id @default(uuid())
  invoiceId String
  userId    String
  eventType String
  message   String
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}
